{
  "name": "pickynotes",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun run --workspaces --if-present test",
    "build": "bun run --workspaces --if-present build",
    "openapi": "bun run --filter @pickynotes/server openapi"
  },
  "trustedDependencies": ["onnxruntime-node", "esbuild", "sharp"],
  "overrides": { "vite": "^6.0.0" },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

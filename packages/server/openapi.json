          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "rerank",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Hits",

        }
      }
    },
    "/admin/webhooks": {
      "post": {
        "summary": "Register a webhook (note.created, note.curated, suggestion.created); HMAC-SHA256 in X-Picky-Signature.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "secret": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 200
                  }
                },
                "required": [
                  "url",
                  "secret"
                ]
              }
            }

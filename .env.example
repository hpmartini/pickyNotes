# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Host directory of the Obsidian vault (mounted to /vault). New notes land in raw/.
VAULT_HOST_PATH=/srv/vault
# Interface to publish on (use the Tailscale IP or 0.0.0.0 behind your own proxy)
PUBLISH_ADDR=127.0.0.1

# Extra IPs/CIDRs allowed on /admin besides 100.64.0.0/10 (Tailscale)
ADMIN_ALLOWLIST=
# Only true behind a reverse proxy you control (reads the last X-Forwarded-For hop)
TRUST_PROXY=false
# Browser origins allowed to call the API (desktop webview); comma separated
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420
RATE_LIMIT_PER_MIN=30
# Max `claude -p` calls per day (counter in DB)
CLAUDE_DAILY_LIMIT=200
MAX_ATTACHMENT_MB=10
# Host port of the API (loopback/PUBLISH_ADDR); change when 8787 is taken
SERVER_PORT=8787

# --- Transcription (leave WHISPER_URL empty to disable: voice captures then fail and are retried) ---
# Local service: docker compose --profile whisper up -d, then
#   WHISPER_URL=http://whisper:8000/v1/audio/transcriptions   WHISPER_API=openai
# WhisperStorm (API format ASSUMED: multipart "file" -> {"text": "..."}): WHISPER_API=whisperstorm
WHISPER_URL=
WHISPER_TOKEN=
WHISPER_API=openai
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_PUBLISH_PORT=8000

# --- Object store for attachments above MAX_ATTACHMENT_MB (leave S3_ENDPOINT empty: those captures get 413) ---
# Local: docker compose --profile s3 up -d, then S3_ENDPOINT=http://s3:9000 (bucket is created on first upload)
S3_ENDPOINT=
S3_BUCKET=pickynotes
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret-min-8
S3_REGION=us-east-1
S3_MAX_ATTACHMENT_MB=100
S3_PUBLISH_PORT=9000
S3_CONSOLE_PORT=9001

# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Host directory of the Obsidian vault (mounted to /vault). New notes land in raw/.
VAULT_HOST_PATH=/srv/vault
# Interface to publish on (use the Tailscale IP or 0.0.0.0 behind your own proxy)
PUBLISH_ADDR=127.0.0.1

# Extra IPs/CIDRs allowed on /admin besides 100.64.0.0/10 (Tailscale)
ADMIN_ALLOWLIST=
# Only true behind a reverse proxy you control (reads the last X-Forwarded-For hop)
TRUST_PROXY=false
# Browser origins allowed to call the API (desktop webview); comma separated
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420
RATE_LIMIT_PER_MIN=30
# Max `claude -p` calls per day (counter in DB)
CLAUDE_DAILY_LIMIT=200
MAX_ATTACHMENT_MB=10
# WhisperStorm transcription endpoint (multipart "file" -> {"text": "..."})
WHISPER_URL=
WHISPER_TOKEN=
